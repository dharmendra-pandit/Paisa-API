# ---------------------------------------------------------------------------
# Paisa — production environment (Hostinger KVM2)
#
# Copy to `.env.production` on the VPS and fill in real values:
#     cp .env.production.example .env.production
#     chmod 600 .env.production
#
# This file must never be committed. `.gitignore` already covers `.env*`, and
# `.dockerignore` keeps it out of the image — the API reads it via `env_file`
# at runtime instead, so secrets live on the host, not in a layer anyone who
# pulls the image can `docker history` out of it.
# ---------------------------------------------------------------------------

# ---------- Domain and TLS ----------
# Must already resolve to this VPS (an A record for IPv4, AAAA if you have v6)
# BEFORE the first `docker compose up`, or Let's Encrypt cannot validate it.
DOMAIN=api.yourdomain.com
# Where Let's Encrypt sends expiry warnings. Use a real inbox you read.
ACME_EMAIL=you@yourdomain.com

# ---------- Server ----------
NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1

# Origins allowed to call the API from a browser. A native mobile app sends no
# Origin header and is unaffected. Do NOT use `*` in production — with
# `credentials: true` it is both a security hole and rejected by browsers.
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ---------- Database ----------
# MONGODB_URI is assembled from these by docker-compose.prod.yml; do not set it
# here or you will override the internal-network address with something wrong.
MONGO_DB_NAME=paisa
# Root account — used only by the init script, never by the API.
MONGO_ROOT_USER=paisa_root
MONGO_ROOT_PASSWORD=CHANGE_ME_long_random_password
# Least-privilege account the API actually connects as (readWrite on paisa only).
MONGO_APP_USER=paisa_app
MONGO_APP_PASSWORD=CHANGE_ME_another_long_random_password

# ---------- Auth (JWT) ----------
# Generate each one separately — never reuse the same value for both:
#     openssl rand -hex 48
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars_access_secret
JWT_REFRESH_SECRET=CHANGE_ME_min_32_chars_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# ---------- App behaviour ----------
APP_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
BUDGET_ALERT_THRESHOLD=0.8

# ---------- Subscription detection ----------
SUBSCRIPTION_MIN_OCCURRENCES=3
SUBSCRIPTION_LOOKBACK_DAYS=210
SUBSCRIPTION_AMOUNT_TOLERANCE=0.15

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ---------- Logging ----------
# `info` emits one structured JSON line per request. Drop to `warn` if the
# access log gets noisy; Docker rotates it at 10MB x 5 either way.
LOG_LEVEL=info

# ---------- API documentation ----------
# Defaults to OFF in production. Interactive docs enumerate every endpoint and
# schema, which is an attack-surface map on a public domain. Set to `true` only
# while you need them, and turn them back off.
SWAGGER_ENABLED=false

# ---------- Paisa AI ----------
# The assistant is optional: with no key the /ai endpoints answer "unavailable"
# and the app hides the tab, rather than the server refusing to boot.
#
# Names are provider-neutral on purpose. Which vendor answers is an
# implementation detail of ai.service.js, and swapping one should not mean
# renaming config across every environment file and deploy script — nor should
# the vendor's name appear anywhere a client or a curious reader can see it.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=800
# Assistant calls cost money upstream, so they get a much tighter per-user
# budget than the blanket API limit.
AI_RATE_LIMIT_MAX=30

# ---------- Backups ----------
# Nightly mongodump retention, in days.
BACKUP_RETENTION_DAYS=14
