# ---------- Server ----------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------- Database ----------
MONGODB_URI=mongodb://127.0.0.1:27017/paisa
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/paisa_test

# ---------- Auth (JWT) ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long_value
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long_value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# ---------- App behaviour ----------
APP_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
BUDGET_ALERT_THRESHOLD=0.8

# ---------- Subscription detection ----------
SUBSCRIPTION_MIN_OCCURRENCES=3
SUBSCRIPTION_LOOKBACK_DAYS=210
SUBSCRIPTION_AMOUNT_TOLERANCE=0.15

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ---------- Logging ----------
LOG_LEVEL=info

# ---------- Paisa AI ----------
# The assistant is optional: with no key the /ai endpoints answer "unavailable"
# and the app hides the tab, rather than the server refusing to boot.
#
# Names are provider-neutral on purpose. Which vendor answers is an
# implementation detail of ai.service.js, and swapping one should not mean
# renaming config across every environment file and deploy script — nor should
# the vendor's name appear anywhere a client or a curious reader can see it.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=800
# Assistant calls cost money upstream, so they get a much tighter per-user
# budget than the blanket API limit.
AI_RATE_LIMIT_MAX=30
