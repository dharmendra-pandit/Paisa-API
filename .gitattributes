# These files are executed on the Linux VPS. Development happens on Windows,
# where git would otherwise hand them back with CRLF endings on checkout — and
# a shell script with CRLF fails at the shebang with a "^M: bad interpreter"
# error that reads like the file is missing. Pin them to LF.
*.sh text eol=lf
Dockerfile text eol=lf
docker-compose*.yml text eol=lf
Caddyfile text eol=lf
*.js text eol=lf
*.json text eol=lf
